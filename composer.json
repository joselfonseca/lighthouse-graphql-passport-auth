{
    "name": "joselfonseca/lighthouse-graphql-passport-auth",
    "description": "Add GraphQL types and mutations for login and recover password functionalities",
    "keywords": [
        "laravel",
        "GraphQL",
        "lighthouse",
        "passport-auth"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Jose Luis Fonseca",
            "email": "jose@ditecnologia.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "nuwave/lighthouse": "^6.0",
        "laravel/passport": "^13.0",
        "laravel/socialite": "^5.0",
        "lcobucci/jwt": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5|^12.0|^13.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "eduarguz/shift-php-cs": "dev-master",
        "laravel/legacy-factories": "^1.4.2",
        "laravel/framework": "^11.35|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Joselfonseca\\LighthouseGraphQLPassport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Joselfonseca\\LighthouseGraphQLPassport\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Joselfonseca\\LighthouseGraphQLPassport\\Providers\\LighthouseGraphQLPassportServiceProvider"
            ]
        }
    },
    "scripts": {
        "check-style": [
            "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff -vvv --using-cache=no --allow-unsupported-php-version=yes"
        ],
        "fix-style": [
            "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php -vvv --using-cache=no --allow-unsupported-php-version=yes"
        ],
        "cs": [
            "@fix-style"
        ]
    }
}
